set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR loongarch64)
if(NOT DEFINED LOONGSON_TOOLCHAIN_ROOT)
  set(LOONGSON_TOOLCHAIN_ROOT "/opt/loongson-gnu-toolchain-8.3-x86_64-loongarch64-linux-gnu-rc1.6")
endif()
set(CMAKE_C_COMPILER "${LOONGSON_TOOLCHAIN_ROOT}/bin/loongarch64-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${LOONGSON_TOOLCHAIN_ROOT}/bin/loongarch64-linux-gnu-g++")
if(DEFINED LOONGSON_SYSROOT)
  set(CMAKE_SYSROOT "${LOONGSON_SYSROOT}")
  set(CMAKE_FIND_ROOT_PATH "${LOONGSON_SYSROOT}")
  set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
  set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
  set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
  set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
endif()
